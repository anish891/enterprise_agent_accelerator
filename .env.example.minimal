# ==============================================================================
# ENTERPRISE AGENT ORCHESTRATOR (crewctl) — MINIMAL ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to '.env' for a basic run with a single LLM provider.
# `crewctl` will automatically load variables from '.env' when present.
# ==============================================================================

# ------------------------------------------------------------------------------
# Choose ONE LLM Provider and set its credential below.
# ------------------------------------------------------------------------------

# --- Azure OpenAI (Default provider in config.yaml) ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- OpenAI Direct ---
# OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- Google Gemini ---
# GEMINI_API_KEY=your-gemini-api-key
